{
  "$schema": "https://raw.githubusercontent.com/Containerpak/cpak/v2/schema/manifest-v3.json",
  "manifest_version": "3.0",
  "name": "Geany",
  "description": "A fast editor with project and build support.",
  "version": "2.1",
  "image": "ghcr.io/containerpak/geany@sha256:5e48247037da99b7a07db8bd02b2846dc234197c3a95511ad2332181615955b7",
  "binaries": [
    "/usr/bin/geany"
  ],
  "desktop_entries": [
    "/usr/share/applications/geany.desktop"
  ],
  "dependencies": [],
  "addons": [
    "github.com/containerpak/sdk-go",
    "github.com/containerpak/sdk-node-lts"
  ],
  "idle_time": 0,
  "override": {
    "socketWayland": true,
    "socketPulseAudio": false,
    "socketSshAgent": true,
    "socketCups": false,
    "socketGpgAgent": true,
    "deviceDri": true,
    "deviceKvm": false,
    "deviceShm": false,
    "deviceAlsa": false,
    "deviceVideo": false,
    "deviceFuse": false,
    "deviceTun": false,
    "deviceUsb": false,
    "deviceAll": false,
    "notification": false,
    "openURI": true,
    "filesystem": [
      {
        "path": "home",
        "access": "read-write"
      }
    ],
    "env": [],
    "network": true,
    "process": false,
    "userNamespaces": false,
    "memoryMaxMB": 0,
    "cpuQuota": 0,
    "pidsMax": 0,
    "asRoot": false
  }
}
